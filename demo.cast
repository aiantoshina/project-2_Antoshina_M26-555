[75.9350905418396,"o","\n"]
[75.93536972999573,"o","\n***Процесс работы с таблицей***\r"]
[75.93549585342407,"o","\nФункции:\r"]
[75.93562054634094,"o","\n<command> create_table <имя> <столбец1:тип> ... - создать таблицу      \r"]
