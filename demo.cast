[75.93588066101074,"o","\n<command> insert into <имя> values (<значения>) - добавить запись      \r"]
[75.93592286109924,"o","\n<command> select from <имя> [where <столбец> = <значение>] - прочитать \u001b[11;1H"]
[75.93598508834839,"o","\n<command> update <имя> set <столбец> = <значение> where <столбец> = <зн\r\n\u001b[10;71Hначение>\r"]
[75.93604588508606,"o","\n<command> delete from <имя> where <столбец> = <значение>\r"]
[75.93611669540405,"o","\n<command> info <имя> - информация о таблице\r"]
[75.93616127967834,"o","\n<command> help - справка\r"]
[75.9362006187439,"o","\n<command> exit - выход\r"]
